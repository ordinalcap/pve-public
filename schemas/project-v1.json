{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordinalcap.github.io/pve-public/schemas/project-v1.json",
  "title": "Platform project request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "description",
    "vmid_range",
    "network"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "description": {
      "type": "string"
    },
    "vmid_range": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 999999999
        },
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 999999999
        }
      ],
      "items": false,
      "minItems": 2
    },
    "storage": {
      "type": "array",
      "items": {
        "enum": [
          "ssd",
          "hdd"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vnet",
        "cidr"
      ],
      "properties": {
        "vnet": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]{1,7}$"
        },
        "cidr": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/24$"
        }
      }
    },
    "codelab": {
      "type": "boolean",
      "description": "Request platform-managed attachment of the development host; subject to platform policy."
    }
  }
}
